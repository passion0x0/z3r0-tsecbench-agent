# TSecBench 托管模式镜像:基于 z3r0-hosted:v7,换成托管入口(env→config→自动解题)。
# 构建: docker build -f Dockerfile.bench -t z3r0-hosted-bench .
FROM z3r0-hosted:v7

# 托管入口 + 自动解题脚本(本地模式这些是运行时 docker cp 进去的,托管需 bake 进镜像)
COPY hosted/start-bench.sh /usr/local/bin/start-bench.sh
COPY score_launch.py /score_launch.py
COPY watch_session.py /watch_session.py
# skills 和 cve-kb 会频繁更新,直接在此层覆盖,不依赖基础镜像 z3r0-hosted:v7 里的旧版本
COPY sandbox/.agents /root/.agents
COPY cve-kb /root/cve-kb
# 应用代码(core/service/...)也会频繁更新,直接在此层覆盖基础镜像 z3r0-hosted:v7 里的旧版本
COPY core /app/core
COPY service /app/service
# ====== 正式赛工具链(Android逆向/加密/逆向分析) ======
# Java JRE (jadx/apktool 依赖)
RUN apt-get update && apt-get install -y --no-install-recommends \
    default-jre-headless \
    binutils \
    file \
    && rm -rf /var/lib/apt/lists/*

# radare2 (轻量逆向分析,macOS/ELF binary)
RUN curl -sL https://github.com/radareorg/radare2/releases/download/6.2.0/radare2_6.2.0_amd64.deb -o /tmp/r2.deb && \
    dpkg -i /tmp/r2.deb 2>/dev/null || apt-get install -f -y --no-install-recommends && \
    rm /tmp/r2.deb


# jadx (APK 反编译)
RUN cd /tmp && \
    curl -sL https://github.com/skylot/jadx/releases/download/v1.5.1/jadx-1.5.1.zip -o jadx.zip && \
    unzip -q jadx.zip -d /opt/jadx && \
    chmod +x /opt/jadx/bin/jadx /opt/jadx/bin/jadx-gui && \
    ln -s /opt/jadx/bin/jadx /usr/local/bin/jadx && \
    rm jadx.zip

# apktool (APK 解包/重打包)
RUN curl -sL https://bitbucket.org/nicholasd/apktool/downloads/apktool_2.9.3.jar -o /usr/local/bin/apktool.jar && \
    printf '#!/bin/bash\njava -jar /usr/local/bin/apktool.jar "$@"\n' > /usr/local/bin/apktool && \
    chmod +x /usr/local/bin/apktool

# Python 安全库(加密/解密/JWT/并发竞争)
RUN pip3 install --no-cache-dir --break-system-packages \
    pycryptodome \
    pyjwt \
    z3-solver

COPY handler /app/handler
COPY middleware /app/middleware
COPY model /app/model
COPY router /app/router
COPY schema /app/schema
COPY utils /app/utils
COPY app.py config.py database.py logger.py main.py /app/
# tiktoken 编码缓存(compaction 的 token 估算需要 cl100k_base/o200k_base,托管无公网必须预下载)
COPY tiktoken-cache /root/.cache/tiktoken

RUN chmod +x /usr/local/bin/start-bench.sh

# 托管模式:启动即自动解题
ENTRYPOINT ["/usr/local/bin/start-bench.sh"]
